# Coffee Lead CRM - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git!

# Google Maps Places API
GOOGLE_MAPS_API_KEY=your_api_key_here

# Google Sheets
# Option 1: Service Account (recommended for automation)
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Option 2: OAuth (for manual use)
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret

# Google Sheet IDs
GOOGLE_SHEET_ID=15JmjQjjQIfhY0zKMzqBlvMMRGgJf3VFVgpOut_DG49s  # Exclusion list (existing contacts)
CRM_SHEET_ID=your_new_crm_sheet_id_here  # New leads sheet (create this)

# Email Configuration (when ready)
# RESEND_API_KEY=your_resend_api_key
# FROM_EMAIL=sam@harkcoffee.com

# Scraper Settings
TARGET_REGION=Adelaide, South Australia
DAILY_EMAIL_LIMIT=200
